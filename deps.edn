{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        seesaw/seesaw {:mvn/version "1.5.0"}
        org.clojure/tools.deps {:mvn/version "0.31.1646"}
        org.clojure/tools.namespace {:mvn/version "1.5.1"}}

 :aliases {:run-m {:main-opts ["-m" "jansenh.clj-go"]}
           :run-x {:ns-default jansenh.clj-go
                   :exec-fn clj-go
                   :exec-args {}}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                   :ns-default build}

           :dev {:extra-paths ["dev"]
                 :main user
                 :repl-options {:init-ns user}}

           :test {:extra-paths ["test"]
                  :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                                io.github.cognitect-labs/test-runner
                                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
